  classDef core fill:#F0E8FD,stroke:#7B52C9,stroke-width:1.5px,color:#2E1A5C
  classDef adapter fill:#E8FDF0,stroke:#2CA05C,stroke-width:1.5px,color:#0B4526
  classDef host fill:#F5F5F5,stroke:#666,stroke-width:1.5px,color:#222

  class S2,S3,S5 global
  class S1,S4 room
