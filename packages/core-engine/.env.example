# ===== LLM 配置（Track B 判定与内心 OS 演化）=====
# 推荐使用极度便宜的模型
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=deepseek-chat

# ===== 绝对死线白名单（这些 QQ 号永不进入 CRISIS 压制）=====
# 多个用英文逗号分隔，例如：123456789,987654321
ADMIN_WHITELIST=

# ===== HTTP 安全（默认只服务本机；详见 README「部署与安全配置」）=====
# 鉴权模式：loopback（只服务本机，默认）| token（必须配 CORE_TOKEN）
# 取其它值会直接拒绝启动，不会静默退回 loopback
AUTH_MODE=loopback
# token 模式的令牌，至少 16 字符；loopback 模式下配了也不生效（启动会打印告警）
CORE_TOKEN=
# Host 白名单（逗号分隔，只写域名/主机名，不带端口）
# 默认只放行 127.0.0.1 / localhost / ::1；用域名或反代访问时必须把对外域名加进来
CORE_EXTRA_HOSTS=
# 绑定地址与端口（loopback 模式下 CORE_HOST 必须是回环地址）
CORE_HOST=127.0.0.1
CORE_PORT=8000

# ===== 可选运行参数（不填则用代码里的默认值）=====
# 防抖窗口：同一用户在该秒数内的连续消息会合并成一次判定
DEBOUNCE_SECONDS=1.2
# Track B 触发阈值：Track A 置信度低于该值时升级到 LLM 轨
TRACK_B_CONFIDENCE=0.55
# 单次 LLM 调用超时（秒）
LLM_TIMEOUT=8

# ===== 记忆路由（阶段五）=====
# 本地兜底记忆库（与 app.db 分开，避免 SQLite 抢写锁）
MEMORY_DB_PATH=
# 记忆存活天数，超过即物理清除（默认 7）
MEMORY_TTL_DAYS=7
# 外部记忆插件（Mem0 等）；留空则只用本地兜底
MEMORY_EXTERNAL_URL=
MEMORY_EXTERNAL_KEY=

# ===== 7 日演化系统（阶段五）=====
# 设为 1 时随服务启动夜间定时任务（每天 03:00 UTC）
EVOLUTION_ENABLED=0
# 人设卡路径（留空则用 core-engine/persona.txt）
PERSONA_PATH=
# 备份目录（留空则用 core-engine/backups）
BACKUP_DIR=
# 当日消息超过该条数才纳入演化素材
EVOLUTION_MIN_MESSAGES=20
